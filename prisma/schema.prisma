generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "debian-openssl-3.0.x", "darwin-arm64"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, uuid_ossp(map: "uuid-ossp")]
}

enum UserRole {
  USER
  ADMIN
  SUPERADMIN
}

model User {
  id           String    @id @default(dbgenerated("uuid_generate_v4()"))
  email        String    @unique
  passwordHash String
  role         UserRole  @default(USER)
  firstName    String?
  lastName     String?
  phone        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  bookings     Booking[]
  rentBookings RentBooking[]
  profile      UserProfile?
}

model Booking {
  id            String   @id @default(dbgenerated("uuid_generate_v4()"))
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  number        String   @unique
  status        String
  propertyId    String?
  arrivalDate   DateTime?
  departureDate DateTime?
  guestsCount   Int?
  totalAmount   Float?
  currency      String?
  payload       Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, createdAt])
}

model RentBooking {
  id                String   @id @default(dbgenerated("uuid_generate_v4()"))
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  rentprogId        String?  // ID брони в RentProg
  carId             String   // ID авто в RentProg
  carName           String   // Кешированное название авто
  carImage          String?  // Кешированное фото
  city              String?
  startDate         DateTime
  endDate           DateTime
  pickupLocation    String?
  returnLocation    String?
  firstName         String
  lastName          String
  phone             String
  totalAmount       Float?
  depositAmount     Float?   // Сумма залога (из RentProg)
  depositStatus     String?  // held | captured | released
  paykeeperPaymentId String? // ID платежа PayKeeper для capture/void холда
  // Статус брони: new | active | cancelled | completed | archived
  status            String   @default("new")
  // Статус оплаты: unpaid | partial | paid
  paymentStatus     String   @default("unpaid")
  paidAmount        Float?   // Оплаченная сумма
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([rentprogId])
}

model UserProfile {
  id                  String   @id @default(dbgenerated("uuid_generate_v4()"))
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId              String   @unique
  // Паспорт
  passportSeries      String?
  passportNumber      String?
  passportIssuedBy    String?
  passportIssuedDate  String?
  passportCode        String?
  // Прописка
  registrationAddress String?
  // Водительское удостоверение
  licenseNumber       String?
  licenseIssuedDate   String?
  licenseExpiryDate   String?
  // Блокировка редактирования после первого сохранения
  isLocked            Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}
